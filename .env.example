# ---- Frontend (Vite) ----
# Copy this file to `.env` and fill in your Supabase project values.
# Find them in the Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Edge Function secrets (set with `supabase secrets set`, NOT in this file) ----
# The recipe function works with ANY OpenAI-compatible endpoint, so you can run
# an open-source model. It defaults to Groq + Gemma (free & fast).
# LLM_API_KEY=your-provider-key            # required (e.g. a free Groq key)
# LLM_BASE_URL=https://api.groq.com/openai/v1   # optional
# LLM_MODEL=gemma2-9b-it                    # optional
