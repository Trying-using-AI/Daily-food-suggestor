# ---- Frontend (Vite) ----
# Copy this file to `.env` and fill in your Supabase project values.
# Find them in the Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Edge Function secrets (set with `supabase secrets set`, NOT in this file) ----
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8   # optional, defaults to claude-opus-4-8
